# ──────────────────────────────────────────────────────────────
# CES ERP backend — mühit konfiqurasiyası ŞABLONU
# Bu faylı `.env` adı ilə kopyalayın və dəyərləri öz mühitinizə uyğun doldurun.
#   cp .env.example .env
# `.env` faylı git-ə commit olunmur.
# ──────────────────────────────────────────────────────────────

# Mobil tətbiqin və web client-lərin çağırdığı public API ünvanı
API_BASE_URL=http://localhost:8083

# CORS — backend-ə sorğu göndərməyə icazəli origin-lər (vergüllə ayrılır)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email linklərində istifadə olunan frontend ünvanı
APP_FRONTEND_URL=http://localhost:3000

# ── Verilənlər bazası (prod/docker mühitində mütləq override olunmalıdır) ──
DB_URL=jdbc:postgresql://localhost:5434/ces_erp
DB_USERNAME=ces_user
DB_PASSWORD=ces_password

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6381

# ── JWT imza açarı (prod-da mütləq unikal, gizli dəyərlə override olunmalıdır) ──
JWT_SECRET=ces-erp-super-secret-key-minimum-256-bit-length-required-here

# ── SMTP (mail göndərilməsi üçün) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Telegram Bot Xəta Bildirişləri ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
